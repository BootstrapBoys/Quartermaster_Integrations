<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compile-only harness for the Quartermaster Integrations sources.
    It compiles the real .cs files from the parent folder against hand-written stubs
    (Stubs.cs) for UnityEngine/TMPro/BepInEx/HarmonyLib/Valheim, because the game and the mod DLLs
    are not available on this machine. Its purpose is compiler diagnostics on OUR code - it is not
    the shipping project and its output must never be deployed.

    Run:  dotnet build /home/hermes/projects/valheim/quartermaster_integrations/build-check/BuildCheck.csproj
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <AssemblyName>QuarterMaster_Integrations_CompileCheck</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS0649;CS0169;CS0067;CS0414;CS1591</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Stubs.cs" />
    <Compile Include="../../src/qi_main.cs" Link="mod/qi_main.cs" />
    <Compile Include="../../src/aaacrafting_integration.cs" Link="mod/aaacrafting_integration.cs" />
    <Compile Include="../../src/adventurebackpacks_integration.cs" Link="mod/adventurebackpacks_integration.cs" />
    <Compile Include="../../src/extraslots_integration.cs" Link="mod/extraslots_integration.cs" />
    <Compile Include="../../src/mlui_integration.cs" Link="mod/mlui_integration.cs" />
    <Compile Include="../../src/aaabuildmenu_integration.cs" Link="mod/aaabuildmenu_integration.cs" />
    <Compile Include="../../src/epicloot_integration.cs" Link="mod/epicloot_integration.cs" />
    <Compile Include="../../src/planbuild_integration.cs" Link="mod/planbuild_integration.cs" />
    <Compile Include="../../src/wardislove_integration.cs" Link="mod/wardislove_integration.cs" />
    <Compile Include="../../src/ward_range.cs" Link="mod/ward_range.cs" />
    <Compile Include="../../src/ward_ownership.cs" Link="mod/ward_ownership.cs" />
    <Compile Include="../../src/craft_repaint.cs" Link="mod/craft_repaint.cs" />
    <Compile Include="../../src/pocket_merge.cs" Link="mod/pocket_merge.cs" />
    <Compile Include="../../src/dropmoreloot_integration.cs" Link="mod/dropmoreloot_integration.cs" />
    <Compile Include="../../src/wizardry_integration.cs" Link="mod/wizardry_integration.cs" />
    <Compile Include="../../src/stack_diagnostics.cs" Link="mod/stack_diagnostics.cs" />
    <Compile Include="../../src/routing_diagnostics.cs" Link="mod/routing_diagnostics.cs" />
    <Compile Include="../../src/forget_override.cs" Link="mod/forget_override.cs" />
    <Compile Include="../../src/stack_crafter_patch.cs" Link="mod/stack_crafter_patch.cs" />
    <Compile Include="../../src/config_order.cs" Link="mod/config_order.cs" />
    <Compile Include="../../src/qi_debugger.cs" Link="mod/qi_debugger.cs" />
  </ItemGroup>

</Project>
